# Copy this file outside the repository, fill every required value, and pass it
# to install.sh with --env. Keep secrets out of the repository.

# Public hostnames. Use two separately registrable domains for the main site
# and user-authored HTML. The LiveKit hostname is reserved even while disabled.
COMMONS_SITE_DOMAIN=
COMMONS_CONTENT_DOMAIN=
COMMONS_LIVEKIT_DOMAIN=

# Backend process settings. COMMONS_API_PORT is the loopback port used by Caddy.
COMMONS_API_PORT=

# SSH firewall safety. A blank port means 22. Only an explicit value of 1 skips
# creation of the rate-limited SSH rule; skipping can lock out remote access.
COMMONS_SSH_PORT=
COMMONS_SKIP_SSH_RULE=

# Durable local paths. COMMONS_BACKUP_ROOT must be on a different block device
# from COMMONS_DB_PATH before real data is admitted.
COMMONS_DATA_DIR=
COMMONS_DB_PATH=
COMMONS_WITHDRAWAL_LOG=
COMMONS_BACKUP_ROOT=

# User-content files. This must stay the Caddy content root. install.sh rejects
# any other path. html_work is the only public URL; upload_raw and img_* land
# here too but are not served.
COMMONS_STORAGE_DIR=/srv/commons-user-content

# Set to 1 only after the backup volume uses full-disk encryption. install.sh
# refuses to continue otherwise. backup.sh does not encrypt files itself.
COMMONS_BACKUP_DISK_ENCRYPTION=

# Health policy. Backups older than this many minutes fail the health check.
COMMONS_BACKUP_MAX_AGE_MINUTES=

# Set to 1 to run the public HTTPS smoke inside healthcheck.sh. Leave blank
# until real domains and certificates exist. This machine cannot verify it.
COMMONS_EDGE_SMOKE=

# LiveKit remains disabled until ROOM-1 passes its reconnect/revocation gates.
COMMONS_LIVEKIT_CONFIG=

# Optional uv release constraint. Leave blank to install the current release.
COMMONS_UV_VERSION=
